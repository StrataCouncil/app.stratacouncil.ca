# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mailtrap — see existing Vercel settings

# Stripe, live: every real strata.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_BASE=
STRIPE_PRICE_MONTHLY_UNIT=
STRIPE_PRICE_ANNUAL_BASE=
STRIPE_PRICE_ANNUAL_UNIT=

# Stripe, sandbox (test mode): only stratas a Super Admin switches to the
# sandbox (0029). The key must be a test key (sk_test_...).
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_MONTHLY_BASE=
STRIPE_TEST_PRICE_MONTHLY_UNIT=
STRIPE_TEST_PRICE_ANNUAL_BASE=
STRIPE_TEST_PRICE_ANNUAL_UNIT=

# Stratasphere AI (all text is PII-stripped before it is sent)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Inngest background jobs (document indexing). Set by the Inngest Vercel
# integration; locally, run `npx inngest-cli@latest dev` instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
